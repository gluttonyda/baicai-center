# ================= 共享鉴权 =================
# Center 管理接口 Bearer Token（Center 必填）。Worker/Scanner 仅在开启 legacy Bearer 兼容时需要同一值。
API_TOKEN=CHANGE_ME
# Center 专用：node_name -> 独立 HMAC token。协议 v2 节点必须逐一配置。
WORKER_TOKEN_MAP={"worker-node-1":"CHANGE_ME_AT_LEAST_32_RANDOM_CHARS"}
# Center 专用：允许提交 is_history_sync 的 HMAC 节点名，逗号分隔；init_sync.py 固定使用 Init_Scanner。
HISTORY_SYNC_NODE_NAMES=Init_Scanner
# 仅在滚动升级旧节点时临时允许共享 Bearer；全新部署保持 false。
ALLOW_LEGACY_NODE_AUTH=false
# 仅兼容升级前已在运行、且 dispatch_id 为 NULL 的旧任务回执。
ALLOW_LEGACY_UNLEASED_REPORTS=false
# 节点 HMAC 时间戳允许的最大时钟偏差（秒）。
NODE_AUTH_MAX_CLOCK_SKEW_SECONDS=300
# 当前 Worker/Scanner/Init Sync 节点独立的 HMAC 密钥，必须与 Center 映射一致。
NODE_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# 仅在兼容旧 Center 时发送共享 Bearer；协议 v2 保持 false。
SCANNER_SEND_BEARER_AUTH=false

# ================= Center: 数据库连接 =================
# MySQL 主机名或容器服务名。
DB_HOST=your-mysql-host
# MySQL 用户名。
DB_USER=google_drive
# MySQL 密码。
DB_PASSWORD=CHANGE_ME
# Center 使用的数据库名。
DB_NAME=google_drive

# ================= Center: 连接池 =================
# 数据库连接池最大连接数。
DB_MAX_CONNECTIONS=50
# 启动时预创建的最小空闲连接数。
DB_MIN_CACHED=1
# 连接池保留的最大空闲连接数。
DB_MAX_CACHED=20

# ================= Center: 调度与清理阈值 =================
# 单次上报最多接收多少文件。
MAX_FILES_PER_REQUEST=10000
# 单次状态回报中 successful_files 的保护上限。
MAX_SUCCESSFUL_FILES=5000
# 单次状态回报中 missing_files 的保护上限。
MAX_MISSING_FILES=5000
# 单次清道夫任务最多下发多少文件。
MAX_CLEANER_FILES_PER_REQUEST=5000
# 北京时间 10:00-次日 01:00，每个 Worker 最多并发的 uploader 数量。
MAX_CONCURRENT_UPLOADS_PER_WORKER_DAY=2
# 北京时间 01:00-10:00，每个 Worker 最多并发的 uploader 数量；不得低于 DAY。
MAX_CONCURRENT_UPLOADS_PER_WORKER_NIGHT=3
# 清道夫在“全组未耗尽”时需要等待的空闲分钟数。
CLEANER_IDLE_MINUTES=20
# 维护开关：false 时冻结下一轮起的 uploader 调度（定时与即时触发都不执行，含超时回收），启动日志提示一次。
# 不取消已在执行的轮次，不冻结各上报接口的写库，也不阻止 Worker 启动恢复。
# 只接受 true/false/1/0/yes/no/on/off；留空等于 true；其它取值拒绝启动。
UPLOADER_DISPATCH_ENABLED=true
# 是否启用中心清道夫自动调度。false 时不会注册 cleaner 定时任务。
CLEANER_DISPATCH_ENABLED=true
# 大脑主动扫描并派发 cleaner 的间隔分钟数。
# 当前 worker 本地只允许 1 个 cleaner 时，建议不要太短，避免重复 409/429 日志。
CLEANER_DISPATCH_INTERVAL_MINUTES=15
# cleaner 执行失败后进入调度冷却的分钟数，避免同一坏批次反复刷 404/403。
CLEANER_FAILURE_COOLDOWN_MINUTES=120
# 普通中转账号和 baicai_big2 使用的根目录。
STAGING_REMOTE_DIR=LongEmby-B
# 旧 baicai_big@1-3 保持使用的根目录。
LEGACY_DIRECT_REMOTE_DIR=LongEmby-A
# 清道夫最终目标 remote。
CLEANER_DEST_REMOTE=baicai-big2
# Worker 多久不活跃会被视为过期节点。
WORKER_STALE_MINUTES=10
# 账号调度执行锁的租约时长。
ACCOUNT_DISPATCH_LEASE_MINUTES=60
# uploading 任务多久没有心跳会被退回 pending。
UPLOADING_STALE_MINUTES=30
# 本地暂时不可见的 not_found 任务多久后自动重试，避免 Scanner 缓存导致永久滞留。
NOT_FOUND_RETRY_MINUTES=60
# 403_quota 触发后的封禁小时数。
QUOTA_BLOCK_HOURS=24
# 即时 uploader 调度遇到另一轮调度正在运行时，最多等待多少秒后放弃并交给定时调度。
DISPATCH_TRIGGER_MAX_WAIT_SECONDS=120
# Cleaner 运行时按实际成功文件分批回报给 Center 的批大小。
# 需小于等于 MAX_SUCCESSFUL_FILES；默认 1000。
CLEANER_REPORT_BATCH_SIZE=1000
# Center 按 successful_files 分批更新数据库的 SQL 批大小。
# 需小于等于 MAX_SUCCESSFUL_FILES；默认 1000。
CLEANER_UPDATE_SQL_CHUNK_SIZE=1000

# ================= Center: Worker 白名单 =================
# node_name -> worker API URL 的 JSON 映射。
# 留空表示信任 Worker 上报的地址，Center 会向该地址发请求（存在被用于访问任意地址的风险）；
# 非空表示只接受白名单节点，且映射地址优先于数据库中的历史地址；修改后需重启 Center 生效。
# 配好后建议同时设置 REQUIRE_WORKER_API_URL_MAP=true，空映射时拒绝启动。
# 地址不允许包含 user:password@，端口必须是 1-65535 的纯数字。
# 非空时 uploader/cleaner 每次派发前都按当前映射重新解析目标地址，修改映射后立即生效；
# worker_registry 中名单外的节点会被跳过并记录 warning。
# 地址必须以 http:// 或 https:// 开头，可以使用内网主机名/IP 和自定义端口；
# 不允许 user:password@ 用户信息、空主机名、非纯数字或不在 1-65535 内的端口、空白和控制字符。
WORKER_API_URL_MAP={"worker-node-1":"http://worker-node-1:8001/task/upload"}
# 为 true 时 WORKER_API_URL_MAP 为空（包括 {}）会拒绝启动；默认 false，仅在启动日志中警告一次，保持现有部署可用。
# 白名单配置完整后建议改为 true，避免映射被误删后退回“信任上报地址”。
REQUIRE_WORKER_API_URL_MAP=false
# 空映射时是否信任 Worker 上报的 worker_api_url。默认 true（兼容现有部署）；
# 设为 false 后所有节点都必须出现在 WORKER_API_URL_MAP 里，否则跳过派发。
TRUST_SELF_REPORTED_WORKER_API_URL=true
# 是否允许派发到 RFC1918 / IPv6 ULA 内网地址。容器网络里的 Worker 就是内网地址，默认 true。
# 设为 false 后只允许 WORKER_API_URL_MAP 里显式批准的地址（以及下面的 ALLOWED_HOSTS）。
# 回环、链路本地（含 169.254.169.254）、各云厂商元数据地址、组播、保留段无论如何都拒绝。
ALLOW_PRIVATE_WORKER_URLS=true
# 逗号分隔的主机名：命中后跳过"内网"判定，但元数据/回环/链路本地仍然拒绝。
# 只用于确实需要走内网代理的受控场景，不要写泛域名。
WORKER_API_ALLOWED_HOSTS=
# Tailscale 等 CGNAT（100.64.0.0/10）上的 Worker：逗号分隔的精确 TailIP（规范 IPv4，不接受 CIDR/范围/主机名/IPv6）。
# 留空保持旧行为（CGNAT 一律拒绝）。非空时必须与 WORKER_API_URL_MAP 双向一致：每个 IP 都要在 map 里以 IP 字面量出现，
# map 里的每个 CGNAT 字面量也都要列在这里，否则拒绝启动。只有 map 中该节点的完整 URL 才能用到豁免；
# 100.100.100.0/24（Tailscale 服务地址、阿里云元数据）永不豁免。示例：100.64.12.34,100.88.1.2
WORKER_API_TAILNET_IPS=

# ================= Worker/Scanner: Center 地址 =================
# Worker 上报状态时访问的 Center 根地址。
CENTER_URL=http://your-center-host:8080
# Scanner 上报文件列表时访问的 Center API。
CENTER_API=http://your-center-host:8080/api/report_files

# ================= Worker/Init Sync: 节点身份 =================
# 当前节点名称；运行 init_sync.py 时必须临时改为 Init_Scanner。
WORKER_NODE_NAME=worker-node-1
# 当前节点暴露给 Center 的上传接口地址。
WORKER_API_URL=http://worker-node-1:8001/task/upload

# ================= Worker/Scanner: 本地目录与目标目录 =================
# 上传和清理任务最终写入的大盘目录名。
TARGET_REMOTE_DIR=LongEmby-B
# Worker 允许处理的本地根目录白名单，多个目录用英文逗号分隔。
ALLOWED_BASE_DIRS=/data/links,/cache/links,/data/rclone-cache
# Scanner 扫描的“软链接/待复制”目录，命中的文件会上报为 copy 任务。
LINKS_SCAN_DIR=/data/links
# Scanner 扫描的缓存 links 目录，命中的文件会上报为 copy 任务。
CACHE_LINKS_SCAN_DIR=/cache/links
# Scanner 扫描的 rclone 缓存目录，命中的文件会上报为 move 任务。
RCLONE_CACHE_SCAN_DIR=/data/rclone-cache
# Worker 本地 rclone 日志目录。
LOG_DIR=/data/logs/rclone
# Scanner 本地 SQLite 缓存库，用来避免重复上报。
CACHE_DB_PATH=/opt/baicai-worker/runtime/scanner_cache.db
# Worker 持久化任务和最终回报的 SQLite 日志；普通重启不得删除。
TASK_JOURNAL_DB_PATH=/opt/baicai-worker/runtime/task_journal.db
TASK_JOURNAL_RETENTION_DAYS=30
# uploader 单进程的文件上传和检查并发。两个账号同时运行时，节点最多产生 8 路文件数据流。
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8

# ================= Scanner: 扫描节奏 =================
# Scanner 每批上报的文件数。
SCANNER_CHUNK_SIZE=1000
# links 目录内文件达到多少小时后才上报。
LINKS_DELAY_HOURS=48
# cache links 目录内文件达到多少小时后才上报。
CACHE_LINKS_DELAY_HOURS=1
# rclone-cache 目录内文件达到多少小时后才上报。
RCLONE_CACHE_DELAY_HOURS=1
# rclone-cache 文件需要保持 size 和 mtime 不变多少秒后才上报，避免搬运未完成的缓存文件。
RCLONE_CACHE_STABLE_SECONDS=900

# ================= Init Sync: 大盘快照导入 =================
# 具备读取目标大盘权限的 rclone 账号名。
RCLONE_REMOTE_ACCOUNT=baicai-big2
# init_sync.py 读取的大盘目录名，应与 TARGET_REMOTE_DIR 对齐。
TARGET_DIR=LongEmby-B
# init_sync.py 每批提交到 Center 的文件数。
INIT_SYNC_CHUNK_SIZE=10000
# init_sync.py 写入失败批次清单的目录。
FAILED_CHUNKS_DIR=./failed_init_sync_chunks
