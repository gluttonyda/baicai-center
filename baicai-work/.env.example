# ================= 共享鉴权 =================
# Worker 和 Scanner 访问 Center 时使用的 Bearer Token，必须与 Center 的 API_TOKEN 一致。
API_TOKEN=CHANGE_ME
# 当前节点独立的 HMAC 密钥，必须与 Center 的 WORKER_TOKEN_MAP 一致。
NODE_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# 协议 v2 不发送共享 Bearer；仅兼容旧 Center 时临时改为 true。
SCANNER_SEND_BEARER_AUTH=false
# 协议 v2 只接受 HMAC 派发；仅兼容旧 Center 时临时改为 true。
ALLOW_LEGACY_BEARER_AUTH=false
# 最终状态回报失败后的重试间隔秒数。
REPORT_RETRY_INTERVAL_SECONDS=30

# ================= Center 地址 =================
# Worker 回报上传状态时访问的 Center 根地址。
CENTER_URL=http://center.example.com:8080
# Scanner 上报待搬运文件列表时访问的 Center API。
CENTER_API=http://center.example.com:8080/api/report_files

# ================= Worker 节点身份 =================
# 当前 Worker 节点名称，必须与 Center 的 WORKER_API_URL_MAP key 完全一致。
WORKER_NODE_NAME=worker-node-1
# 当前 Worker 对 Center 暴露的上传任务接收接口。
WORKER_API_URL=http://worker-node-1.example.com:8001/task/upload

# ================= 本地目录与目标目录 =================
# 上传和清理任务最终写入的大盘目录名。
TARGET_REMOTE_DIR=LongEmby-B
# Worker 允许处理的本地根目录白名单，多个目录用英文逗号分隔。
ALLOWED_BASE_DIRS=/data/links,/cache/links,/data/rclone-cache
# Scanner 扫描的软链接/待复制目录，命中的文件会上报为 copy 任务。
LINKS_SCAN_DIR=/data/links
# Scanner 扫描的缓存 links 目录，命中的文件会上报为 copy 任务。
CACHE_LINKS_SCAN_DIR=/cache/links
# Scanner 扫描的 rclone 缓存目录，命中的文件会上报为 move 任务。
RCLONE_CACHE_SCAN_DIR=/data/rclone-cache
# Scanner 本地 SQLite 缓存库，用来避免重复上报。
CACHE_DB_PATH=/opt/baicai-worker/runtime/scanner_cache.db
# Worker 持久化任务和最终回报的 SQLite 日志；必须位于持久卷中。
TASK_JOURNAL_DB_PATH=/opt/baicai-worker/runtime/task_journal.db
TASK_JOURNAL_RETENTION_DAYS=30
# uploader 的单个 rclone 进程带宽上限；只限制上传，不限制 cleaner 的网盘到网盘互传。
# 示例：375M 约等于 3Gbps；如果节点最多 2 个上传账号并发，总量约 6Gbps。
RCLONE_BWLIMIT=
# 每个 uploader rclone 同时读取和上传的文件数。两个账号并发时，4 表示节点最多 8 路数据流。
RCLONE_TRANSFERS=4
# rclone 并行检查数；机械盘节点不建议设置过高。
RCLONE_CHECKERS=8
# 北京时间 10:00-次日 01:00，当前 worker 本地最多允许同时运行多少个 uploader rclone。
# 这是 worker 侧保险；Center 应配置相同的昼夜并发值。
MAX_CONCURRENT_UPLOADS_PER_WORKER_DAY=2
# 北京时间 01:00-10:00 的 uploader rclone 并发上限；不得低于 DAY。
MAX_CONCURRENT_UPLOADS_PER_WORKER_NIGHT=3
# 当前 worker 本地最多允许同时运行多少个 cleaner rclone move。
# 建议保持 1，避免清道夫重复堆积导致 /task/upload 响应超时。
MAX_CONCURRENT_CLEANERS_PER_WORKER=1

# ================= Scanner 扫描配置 =================
# Scanner 每批上报的文件数。
SCANNER_CHUNK_SIZE=1000
# links 目录内文件达到多少小时后才上报。
LINKS_DELAY_HOURS=48
# cache links 目录内文件达到多少小时后才上报。
CACHE_LINKS_DELAY_HOURS=1
# rclone-cache 目录内文件达到多少小时后才上报。
RCLONE_CACHE_DELAY_HOURS=1
# rclone-cache 文件需要保持 size 和 mtime 不变多少秒后才上报，避免搬运未完成的缓存文件。
RCLONE_CACHE_STABLE_SECONDS=900
# Scanner 主循环间隔秒数。
SCANNER_LOOP_SECONDS=300

# ================= Cleaner 回报配置 =================
# cleaner 按实际成功文件分批回报给 Center 的批大小。
CLEANER_REPORT_BATCH_SIZE=1000
